# ──────────────────────────────────────────────────────────────
# Weiley AroFlo Dashboard — environment configuration
# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env file (it is gitignored).
# ──────────────────────────────────────────────────────────────

# Port the dashboard runs on
PORT=3000

# ── Claude (Anthropic) ────────────────────────────────────────
# Get a key at https://console.anthropic.com/  → API Keys
# Leave blank to run the chat in MOCK mode (canned answers, no API calls).
ANTHROPIC_API_KEY=

# Model to use. Opus 4.8 is the most capable; swap for claude-sonnet-4-6
# if you want faster/cheaper responses.
CLAUDE_MODEL=claude-opus-4-8

# ── AroFlo API ────────────────────────────────────────────────
# Set AROFLO_ENABLED=true once you have real credentials.
# While false, the dashboard serves realistic MOCK data so you can
# build and demo without touching your live AroFlo account.
AROFLO_ENABLED=false

# AroFlo API base URL (confirm yours in AroFlo: Site Admin → API).
AROFLO_BASE_URL=https://api.aroflo.com

# AroFlo API credentials (from AroFlo: Site Admin → API Access).
# These authenticate as an API user via an HMAC-signed request.
AROFLO_CUID=
AROFLO_ORG_ENCODED_KEY=
AROFLO_USER_NAME=
AROFLO_U_ENCODED_KEY=
