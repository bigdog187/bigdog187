# OEE Dashboard configuration
# Copy to .env and adjust as needed.

# HTTP / WebSocket server port
PORT=3000

# Path to the SQLite database file
DB_PATH=./data/oee.db

# How many days of raw samples to retain (older rows are pruned hourly)
SAMPLE_RETENTION_DAYS=30

# Seed a demo site + simulated machine on first boot if the DB is empty (true/false)
SEED_DEMO=true
