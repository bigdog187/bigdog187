# Copy to .env (or set these in the service environment) on the on-site PC.
# The defaults run everything against a local SQLite file with simulated PLCs,
# so you can demo with zero configuration.

# ---- Demo / development -----------------------------------------------------
# Force every line onto the data simulator (no PLCs required):
# MES_SIMULATE=1

# Run the collector inside the web process (single-box / demo deployment):
# MES_RUN_COLLECTOR=1

# ---- Web server -------------------------------------------------------------
MES_WEB_HOST=0.0.0.0
MES_WEB_PORT=8000

# ---- Database: SQLite (default) ---------------------------------------------
# MES_DB_BACKEND=sqlite
# MES_SQLITE_PATH=./data/earlyrise_mes.db

# ---- Database: Microsoft SQL Server (on-site) -------------------------------
# MES_DB_BACKEND=sqlserver
# MES_SQLSERVER_HOST=BAKERY-SQL\SQLEXPRESS      # or  10.0.0.5,1433
# MES_SQLSERVER_DB=EarlyriseMES
# MES_SQLSERVER_DRIVER=ODBC Driver 17 for SQL Server
# Use a SQL login...
# MES_SQLSERVER_USER=mes_writer
# MES_SQLSERVER_PASSWORD=change-me
# ...or Windows integrated auth instead:
# MES_SQLSERVER_TRUSTED=1

# Or specify a full SQLAlchemy URL and skip the pieces above:
# MES_DATABASE_URL=mssql+pyodbc://user:pass@host/EarlyriseMES?driver=ODBC+Driver+17+for+SQL+Server

# ---- Config file location (optional) ----------------------------------------
# MES_CONFIG=./config/lines.yaml
